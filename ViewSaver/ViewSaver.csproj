<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ViewSaver</AssemblyName>
    <RootNamespace>ViewSaver</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ViewSaver.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Version>1.1.0</Version>
    <Authors>ViewSaver</Authors>
    <PackageProjectUrl>https://github.com/gdjenks13/ViewSaver</PackageProjectUrl>
    <Description>Monitor Profile Manager - Save and switch between display configurations</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ViewSaver.ico" LogicalName="ViewSaver.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
